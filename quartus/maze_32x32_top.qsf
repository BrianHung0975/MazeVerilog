# --- Clock & Onboard I/O ---
set_location_assignment PIN_28 -to clk
set_location_assignment PIN_132 -to rst_n
set_location_assignment PIN_134 -to sw_row_inv
set_location_assignment PIN_122 -to led_alive
set_location_assignment PIN_123 -to led_win

# --- Virtual Direction Buttons (input0 ~ input3) ---
set_location_assignment PIN_226 -to btn_up
set_location_assignment PIN_225 -to btn_down
set_location_assignment PIN_224 -to btn_left
set_location_assignment PIN_223 -to btn_right

# --- Matrix LED 16x16 Row (output0 ~ output15) ---
set_location_assignment PIN_60 -to mat_row[15]
set_location_assignment PIN_59 -to mat_row[14]
set_location_assignment PIN_58 -to mat_row[13]
set_location_assignment PIN_57 -to mat_row[12]
