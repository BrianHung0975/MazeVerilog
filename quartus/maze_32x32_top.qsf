set_location_assignment PIN_53 -to mat_row[8]
set_location_assignment PIN_50 -to mat_row[7]
set_location_assignment PIN_49 -to mat_row[6]
set_location_assignment PIN_48 -to mat_row[5]
set_location_assignment PIN_47 -to mat_row[4]
set_location_assignment PIN_46 -to mat_row[3]
set_location_assignment PIN_45 -to mat_row[2]
set_location_assignment PIN_44 -to mat_row[1]
set_location_assignment PIN_43 -to mat_row[0]

# --- Matrix LED 16x16 Col (output16 ~ output31) ---
set_location_assignment PIN_42 -to mat_col[15]
set_location_assignment PIN_41 -to mat_col[14]
set_location_assignment PIN_23 -to mat_col[13]
set_location_assignment PIN_21 -to mat_col[12]
set_location_assignment PIN_20 -to mat_col[11]
set_location_assignment PIN_19 -to mat_col[10]
set_location_assignment PIN_18 -to mat_col[9]
set_location_assignment PIN_17 -to mat_col[8]
set_location_assignment PIN_16 -to mat_col[7]
set_location_assignment PIN_15 -to mat_col[6]
set_location_assignment PIN_14 -to mat_col[5]
set_location_assignment PIN_13 -to mat_col[4]
set_location_assignment PIN_12 -to mat_col[3]
set_location_assignment PIN_11 -to mat_col[2]
set_location_assignment PIN_8 -to mat_col[1]
set_location_assignment PIN_7 -to mat_col[0]

# --- Seven Segment Tens (output35 ~ output41) ---
set_location_assignment PIN_61 -to seg_tens[6]
set_location_assignment PIN_62 -to seg_tens[5]
set_location_assignment PIN_63 -to seg_tens[4]
set_location_assignment PIN_64 -to seg_tens[3]
set_location_assignment PIN_65 -to seg_tens[2]
set_location_assignment PIN_66 -to seg_tens[1]
set_location_assignment PIN_67 -to seg_tens[0]

# --- Seven Segment Ones (output42 ~ output48) ---
set_location_assignment PIN_68 -to seg_ones[6]
set_location_assignment PIN_73 -to seg_ones[5]
set_location_assignment PIN_2 -to seg_ones[4]
set_location_assignment PIN_238 -to seg_ones[3]
set_location_assignment PIN_237 -to seg_ones[2]
set_location_assignment PIN_236 -to seg_ones[1]
set_location_assignment PIN_235 -to seg_ones[0]

# --- Unused Pins Protection ---
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
